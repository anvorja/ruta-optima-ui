# Optional. Public values (they are bundled into the browser build): never put secrets here.
# Default: standard OpenStreetMap tiles (no key, light use only). For production, point these
# at a provider you have an agreement with; restrict any key by domain.
# VITE_TILE_URL_DARK=https://tiles.example.com/dark/{z}/{x}/{y}.png
# VITE_TILE_URL_LIGHT=https://tiles.example.com/light/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Your provider
